---
// Text wordmark plus the section link. No logo until brand assets exist (styleguide: Header).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const engineeringHref = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/engineering/`;
const inEngineering = Astro.locals.starlightRoute.id.startsWith('engineering');
---

<a href={siteTitleHref} class="site-title" translate="no">{siteTitle}</a>
<a
	href={engineeringHref}
	class="section-link"
	aria-current={inEngineering ? 'true' : undefined}>Engineering</a
>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--hb-text);
		text-decoration: none;
		white-space: nowrap;
	}

	.section-link {
		display: none;
		align-items: center;
		min-height: 2rem;
		margin-inline-start: 1.25rem;
		font-size: 0.875rem;
		color: var(--hb-text-muted);
		text-decoration: none;
		white-space: nowrap;
	}

	.section-link:hover,
	.section-link[aria-current] {
		color: var(--hb-text);
	}

	@media (min-width: 50em) {
		.section-link {
			display: inline-flex;
		}
	}
</style>
